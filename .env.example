# Admin dashboard key — required in production
# Used at /admin to view customer pickup requests
ADMIN_KEY=change-me-in-production

# Supabase (optional for local dev, required for production)
# See docs/SUPABASE.md for setup guide
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Optional: webhook URL called when a new pickup is submitted
# PICKUP_WEBHOOK_URL=https://hooks.slack.com/services/xxx
